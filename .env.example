# ── Local-first defaults for SPM B2B BE workstations ────────────────────────
# By default everything runs locally with SQLite — no Postgres install needed.
# Override DATABASE_URL only if you want to use a shared PostgreSQL/TimescaleDB.
DATABASE_URL=sqlite:///data/solar_forecast.db

# Local storage directories (created automatically)
DATA_DIR=data/raw
MODEL_DIR=models

# docker-compose Postgres credentials (required when running via docker compose)
POSTGRES_DB=solar_forecast
POSTGRES_USER=solar
POSTGRES_PASSWORD=change_me_in_local_env

# Scraper
SCRAPE_INTERVAL_MINUTES=15

# Open-Meteo (no API key required for free tier)
OPENMETEO_CACHE_TTL=3600

# Output API
API_HOST=127.0.0.1
API_PORT=8000
